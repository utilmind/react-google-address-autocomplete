{
    "name": "react-google-address-autocomplete-workspace",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "pnpm --filter address-autocomplete-demo dev",
        "build": "pnpm -r build",
        "lint": "eslint .",
        "test": "pnpm -r test",
        "typecheck": "pnpm -r typecheck",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepublish:check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "@testing-library/react": "^16.3.0",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^22.19.11",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.1.1",
        "eslint": "^9.39.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.4.24",
        "globals": "^16.5.0",
        "jsdom": "^27.3.0",
        "prettier": "^3.8.1",
        "tsup": "^8.5.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.50.0",
        "vite": "^7.2.7",
        "vitest": "^4.0.15"
    },
    "prettier": {
        "tabWidth": 4,
        "useTabs": false,
        "singleQuote": true,
        "jsxSingleQuote": false,
        "semi": false,
        "trailingComma": "all",
        "printWidth": 120
    },
    "packageManager": "pnpm@10.9.0",
    "engines": {
        "node": "22.x"
    }
}
