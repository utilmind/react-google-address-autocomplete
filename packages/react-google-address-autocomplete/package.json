{
    "name": "react-google-address-autocomplete",
    "version": "0.0.0",
    "description": "Reusable React address autocomplete component powered by Google Places Autocomplete Data API.",
    "type": "module",
    "sideEffects": false,
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "scripts": {
        "build": "tsup",
        "test": "vitest run",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "keywords": [
        "react",
        "google",
        "places",
        "autocomplete",
        "address",
        "typescript"
    ],
    "peerDependencies": {
        "react": ">=18.3.0 <20",
        "react-dom": ">=18.3.0 <20"
    },
    "license": "MIT"
}
